{
  "name": "arkangel",
  "version": "1.0.1",
  "description": "Arkangel — Cobranza asistida por IA sobre Cloudflare Workers (Workers AI + Resend + WhatsApp Cloud API + Telnyx)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:frontend && wrangler dev",
    "dev:frontend": "vite build --watch",
    "assets:watermark": "python scripts/forge_arkangel_watermark.py --quiet",
    "assets:watermark:force": "python scripts/forge_arkangel_watermark.py --force",
    "prebuild": "npm run assets:watermark || echo [assets] watermark omitido: python no disponible",
    "predeploy": "npm run assets:watermark || echo [assets] watermark omitido: python no disponible",
    "build": "npm run build:frontend && npm run build:worker",
    "forge:assets": "python scripts/forge_meridian_assets.py",
    "build:frontend": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir=dist/worker",
    "deploy": "npm run build:frontend && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests frontend/src design-system --max-warnings 0",
    "lint:fix": "eslint src tests frontend/src design-system --fix",
    "format": "prettier --write \"{src,tests,frontend/src,design-system}/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{src,tests,frontend/src,design-system}/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "verify": "npm run format && npm run lint:fix && npm run typecheck && npm run test && npm run build",
    "db:migrate": "wrangler d1 migrations apply arkangel-cobranza-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply arkangel-cobranza-db --local",
    "db:seed": "wrangler d1 execute arkangel-cobranza-db --file=./scripts/seed.sql --local",
    "spike:voz": "tsx scripts/spike-voz.ts",
    "seed:owner": "tsx scripts/seed-owner.ts",
    "seed:owner:remote": "tsx scripts/seed-owner.ts --remote",
    "seed:tenant-config": "tsx scripts/seed-tenant-config.ts",
    "seed:tenant-config:remote": "tsx scripts/seed-tenant-config.ts --remote",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf dist node_modules/.vite .wrangler/tmp"
  },
  "dependencies": {
    "hono": "^4.6.12",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
