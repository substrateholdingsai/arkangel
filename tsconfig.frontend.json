{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"],
      "@ds": ["design-system/index.ts"],
      "@ds/*": ["design-system/*"]
    },
    "types": ["vite/client"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["frontend/src/**/*", "design-system/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
