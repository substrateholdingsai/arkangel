{
  "$schema": "https://json.schemastore.org/wrangler.jsonc",
  "name": "arkangel-cobranza",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "dist/frontend", "binding": "ASSETS" },
  "vars": {
    "ENVIRONMENT": "production",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "DEDUPE_WINDOW_HOURS": "24",
    "RATE_LIMIT_RPM": "42",
    "SEND_WINDOW_START": "8",
    "SEND_WINDOW_END": "22",
    "TZ": "America/Mexico_City",
    "SCORE_AMOUNT_CEILING_CENTS": "200000",
    "CRON_AUTO_FIRE": "false",
    "DRY_RUN": "false",
    "LEGAL_RAZON_SOCIAL": "Arkangel Cobranza Legal S.A.P.I. de C.V.",
    "LEGAL_CONDUSEF_REGISTRO": "REDECO-2026-0042",
    "ALLOWED_PAYMENT_DOMAINS": "arksystems.site,pagos.arksystems.site",
    "MAX_CONTACTS_PER_DAY": "3",
    "LEGAL_MONTO_TOLERANCIA_CENTS": "0",
    "LEGAL_HORARIO_EN_RESPUESTAS": "false",
    "ALEGRA_IVA_PCT": "16",
    "RESEND_FROM_EMAIL": "Arkangel <cobranza@mail.arksystems.site>",
    "AUTH_FROM_EMAIL": "Arkangel <no-reply@auth.arksystems.site>",
    "APP_URL": "https://arkangel.arksystems.site",
    "SPIKE_VOZ_ENABLED": "false",
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arkangel-cobranza-db",
      "database_id": "5955313e-eadd-4658-874c-3366c1d24c24",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "6665e3e000884081a0fa5cd4674f5dad" }],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "arkangel-contabilidad",
    },
    {
      "binding": "HERMES_MEMORY_BUCKET",
      "bucket_name": "arkangel-hermes-snapshots",
    },
  ],
  "queues": {
    "producers": [{ "binding": "COBRANZA_QUEUE", "queue": "arkangel-cobranza-queue" }],
    "consumers": [
      {
        "queue": "arkangel-cobranza-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "arkangel-cobranza-dlq",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      { "name": "CALL_LOCK", "class_name": "CallLockDO" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDO" },
      { "name": "CALL_SESSION", "class_name": "CallSessionDO" },
      { "name": "HERMES_SANDBOX", "class_name": "HermesSandboxDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CallLockDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiterDO"] },
    { "tag": "v3", "new_sqlite_classes": ["CallSessionDO"] },
    { "tag": "v4", "new_sqlite_classes": ["HermesSandboxDO"] },
  ],
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 12 * * *", "59 5 * * *"] },
}
